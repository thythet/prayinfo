<script>
(function(){
  const DEFAULT_PRAYER_ROW_HEIGHT = 52;

  function autoGrowPrayerTextarea(ta){
    if(!ta) return;

    ta.style.height = DEFAULT_PRAYER_ROW_HEIGHT + 'px';
    const newHeight = Math.max(DEFAULT_PRAYER_ROW_HEIGHT, ta.scrollHeight);
    ta.style.height = newHeight + 'px';

    const tr = ta.closest('tr');
    const td = ta.closest('td');

    if(td){
      td.style.height = newHeight + 'px';
      td.style.minHeight = DEFAULT_PRAYER_ROW_HEIGHT + 'px';
    }

    if(tr){
      tr.style.height = newHeight + 'px';
      tr.style.minHeight = DEFAULT_PRAYER_ROW_HEIGHT + 'px';
    }
  }

  function normalizePrayerRows(){
    document.querySelectorAll('#prayerRows tr').forEach(function(row){
      const ta = row.querySelector('textarea');
      if(ta){
        autoGrowPrayerTextarea(ta);
      }else{
        row.style.height = DEFAULT_PRAYER_ROW_HEIGHT + 'px';
        row.style.minHeight = DEFAULT_PRAYER_ROW_HEIGHT + 'px';
      }
    });
  }

  document.addEventListener('input', function(e){
    if(e.target && e.target.matches && e.target.matches('#prayerRows textarea')){
      autoGrowPrayerTextarea(e.target);
    }
  }, true);

  document.addEventListener('click', function(){
    setTimeout(normalizePrayerRows, 80);
  }, true);

  document.addEventListener('change', function(){
    setTimeout(normalizePrayerRows, 80);
  }, true);

  window.addEventListener('beforeprint', normalizePrayerRows);
  window.addEventListener('resize', normalizePrayerRows);
  document.addEventListener('DOMContentLoaded', normalizePrayerRows);
  setInterval(normalizePrayerRows, 1200);

  window.normalizePrayerRows = normalizePrayerRows;
})();
</script>


<script>
(function(){
  function setNameColumnWidth(){
    document.querySelectorAll('.inner-table colgroup col:nth-child(2)').forEach(function(col){
      col.setAttribute('style','width:220px');
    });
    document.querySelectorAll('.prayer-header .name-col, #prayerRows .name-col').forEach(function(el){
      el.style.width = '220px';
    });
  }

  function alignPrayerRows(){
    document.querySelectorAll('#prayerRows tr').forEach(function(row){
      const num = row.querySelector('.number-col');
      const nameCell = row.querySelector('.name-col');
      const nameDisplay = row.querySelector('.name-display');
      if(num){
        num.style.textAlign = 'center';
        num.style.verticalAlign = 'middle';
      }
      if(nameCell){
        nameCell.style.width = '220px';
        nameCell.style.verticalAlign = 'middle';
      }
      if(nameDisplay){
        nameDisplay.style.display = 'flex';
        nameDisplay.style.alignItems = 'center';
        nameDisplay.style.minHeight = '52px';
      }
    });
  }

  function removeOldSeparatorRows(){
    document.querySelectorAll('.print-separator-row').forEach(function(row){
      row.remove();
    });
  }

  function addPrintSeparatorRow(){
    removeOldSeparatorRows();

    const rows = Array.from(document.querySelectorAll('#prayerRows tr'));
    if(!rows.length) return;

    let lastUsedIndex = -1;
    rows.forEach(function(row, index){
      const name = row.querySelector('.name-display')?.textContent?.trim() || '';
      const request = row.querySelector('textarea')?.value?.trim() || '';
      const num = row.querySelector('.number-col')?.textContent?.trim() || '';
      if(name || request || num){
        lastUsedIndex = index;
      }
    });

    if(lastUsedIndex < 0) return;

    const sep = document.createElement('tr');
    sep.className = 'print-separator-row';
    sep.innerHTML = '<td colspan="3"></td>';

    rows[lastUsedIndex].after(sep);
  }

  function finalTableFix(){
    setNameColumnWidth();
    alignPrayerRows();
  }

  window.addEventListener('beforeprint', function(){
    finalTableFix();
    addPrintSeparatorRow();
  });

  window.addEventListener('afterprint', function(){
    removeOldSeparatorRows();
  });

  document.addEventListener('DOMContentLoaded', finalTableFix);
  document.addEventListener('click', function(){ setTimeout(finalTableFix,80); }, true);
  document.addEventListener('change', function(){ setTimeout(finalTableFix,80); }, true);
  window.addEventListener('resize', finalTableFix);
  setInterval(finalTableFix,1200);
})();
</script>


