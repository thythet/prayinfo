  min-height:calc(1040px * ((100vw - 42px) / 900) + 20px);
}
.paper{
  transform:scale(calc((100vw - 42px) / 900));
}
}
.print-only{display:none}@media print{body{background:#fff}.app,.login-wrap{display:none!important}.print-only{display:block}.paper{width:100%;box-shadow:none;padding:0}}

/* Fix participant controls alignment */
