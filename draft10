/* Mobile paper scaling */
.paper{
  width:900px;
  max-width:900px;
  transform:scale(calc((100vw - 52px) / 900));
  transform-origin:top left;
  margin:0;
  padding:24px 28px 32px;
  border-radius:2px;
}
#formBox{
  overflow:hidden;
}
#formBox .paper{
  margin-bottom:calc((100vw - 52px) / 900 * -1px);
}
.shell:has(.paper){
  min-height:calc(980px * ((100vw - 52px) / 900) + 20px);
}

/* fallback if :has is not supported */
.form-mobile-holder{
  width:100%;
  overflow:hidden;
}

.subhead{grid-template-columns:1fr 1fr 1fr;gap:16px;font-size:18px}
.subhead .center{text-align:center}
.subhead .right{text-align:right}
.name-col{width:250px}
.field-panel{width:320px}
.label-cell,.number-col,.participant-wrap>span{font-size:18px}
}

@media(max-width:420px){
