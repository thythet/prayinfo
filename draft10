<script>
(function(){
  function getFieldAreaText(){
    const ids = ['fieldValue','fieldAreaValue'];
    for(const id of ids){
      const el = document.getElementById(id);
      if(el && el.textContent.trim()) return el.textContent.trim();
    }
    const toggle = document.querySelector('.field-toggle,.field-area-toggle');
    if(toggle) return toggle.textContent.replace(/[⌄▾▼]/g,'').trim();
    return '';
  }

  function ensurePrintFieldAreaText(){
    const fieldValue = document.getElementById('fieldValue') || document.getElementById('fieldAreaValue');
    if(!fieldValue) return;

    let printText = document.getElementById('printFieldAreaText');
    if(!printText){
      printText = document.createElement('span');
      printText.id = 'printFieldAreaText';
      printText.className = 'print-field-area-text';
      fieldValue.after(printText);
    }

    printText.textContent = getFieldAreaText();
  }

  function removeSeparatorRows(){
    document.querySelectorAll('tr.print-separator-row').forEach(r => r.remove());
  }

  function forcePrintSeparatorRow(){
    removeSeparatorRows();

    const tbody = document.getElementById('prayerRows');
    if(!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('tr')).filter(r => !r.classList.contains('print-separator-row'));
    if(!rows.length) return;

    let lastUsed = -1;
    rows.forEach((row, idx) => {
      const name = row.querySelector('.name-display')?.textContent?.trim() || '';
      const textAreaValue = row.querySelector('textarea')?.value?.trim() || '';
      const printValue = row.querySelector('.print-textarea-value')?.textContent?.trim() || '';
      const number = row.querySelector('.number-col')?.textContent?.trim() || '';
      if(name || textAreaValue || printValue || number){
        lastUsed = idx;
      }
    });

    if(lastUsed < 0) return;

    const sep = document.createElement('tr');
    sep.className = 'print-separator-row';
    sep.innerHTML = '<td colspan="3">&nbsp;</td>';

    rows[lastUsed].insertAdjacentElement('afterend', sep);
  }

  function finalPrintPrepare(){
    ensurePrintFieldAreaText();
    forcePrintSeparatorRow();
  }

  window.addEventListener('beforeprint', finalPrintPrepare);
  window.addEventListener('afterprint', function(){
    removeSeparatorRows();
  });

  document.addEventListener('DOMContentLoaded', ensurePrintFieldAreaText);
  document.addEventListener('click', function(){
    setTimeout(ensurePrintFieldAreaText, 80);
  }, true);
  document.addEventListener('change', function(){
    setTimeout(ensurePrintFieldAreaText, 80);
  }, true);

  window.finalPrintPrepare = finalPrintPrepare;
})();
</script>


<script>
(function(){
  function cleanPdfNamePart(value){
    return (value || '')
      .replace(/[⌄▾▼:]/g, '')
      .replace(/\s+/g, '')
      .trim();
  }

  function normalizeDateForFileName(rawDate){
    rawDate = (rawDate || '').trim();

    if(!rawDate){
      return new Date().toISOString().slice(0,10);
    }

    // If already YYYY-MM-DD
    if(/^\d{4}-\d{2}-\d{2}$/.test(rawDate)){
      return rawDate;
    }

    // Convert MM/DD/YYYY or DD/MM/YYYY safely.
    if(rawDate.includes('/')){
      const parts = rawDate.split('/').map(p => p.padStart(2, '0'));
      if(parts.length === 3){
        const a = parts[0];
        const b = parts[1];
        const y = parts[2];

        // Browser date display usually MM/DD/YYYY in Chrome print preview
        if(y.length === 4){
          return `${y}-${a}-${b}`;
        }
      }
    }

    return rawDate.replace(/[^\d-]/g, '');
  }

  function getCurrentAreaForFileName(){
    const area =
      document.getElementById('fieldValue')?.textContent ||
      document.getElementById('fieldAreaValue')?.textContent ||
      document.querySelector('.field-toggle')?.textContent ||
      'Unknown';

    return cleanPdfNamePart(area);
  }

  function getCurrentDateForFileName(){
    const rawDate =
      document.getElementById('currentDate')?.value ||
      document.getElementById('entryDate')?.value ||
      document.getElementById('dateValue')?.textContent ||
      '';

    return normalizeDateForFileName(rawDate);
  }

  function setPrayInfoPdfFileName(){
    const area = getCurrentAreaForFileName();
    const date = getCurrentDateForFileName();
    const fileName = `ពួកជំនុំតាមផ្ទះ-វៀលស្មៅ${area}-${date}.pdf`;

    // Chrome/Edge Save as PDF uses document.title as default filename.
    document.title = fileName;
  }

  function installPdfFileNameFix(){
    const exportBtn = document.getElementById('exportBtn') || document.getElementById('exportPdfBtn');
    if(exportBtn && !exportBtn.dataset.pdfNameFixed){
      exportBtn.dataset.pdfNameFixed = '1';
      exportBtn.addEventListener('click', function(){
        setPrayInfoPdfFileName();
      }, true);
    }
  }

  window.addEventListener('beforeprint', setPrayInfoPdfFileName);
  document.addEventListener('DOMContentLoaded', installPdfFileNameFix);
  document.addEventListener('click', function(){
    setTimeout(installPdfFileNameFix, 50);
  }, true);
  setInterval(installPdfFileNameFix, 1000);

  window.setPrayInfoPdfFileName = setPrayInfoPdfFileName;
})();
</script>


