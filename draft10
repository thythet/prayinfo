<script>
(function(){
  function rowHasData(row){
    const name = row.querySelector('.name-display')?.textContent?.trim() || '';
    const number = row.querySelector('.number-col')?.textContent?.trim() || '';
    const textarea = row.querySelector('textarea')?.value?.trim() || '';
    const printText = row.querySelector('.print-textarea-value')?.textContent?.trim() || '';
    return !!(name || number || textarea || printText);
  }

  function addOneVisiblePrintGapRow(){
    const tbody = document.getElementById('prayerRows');
    if(!tbody) return;

    // remove old gap rows/separators from any previous print
    tbody.querySelectorAll('.print-gap-row,.print-separator-row').forEach(row => row.remove());

    const rows = Array.from(tbody.querySelectorAll('tr')).filter(row => !row.classList.contains('print-gap-row'));

    let lastDataRow = null;
    rows.forEach(row => {
      if(rowHasData(row)) lastDataRow = row;
    });

    // If no data row, place after the first row area
    if(!lastDataRow){
      lastDataRow = rows[0] || null;
    }
    if(!lastDataRow) return;

    const gap = document.createElement('tr');
    gap.className = 'print-gap-row';
    gap.innerHTML = '<td colspan="3">&nbsp;</td>';

    // insert exactly after last used prayer row, before bottom rows
    /* static gap row used; no dynamic gap */
  }

  function removeVisiblePrintGapRow(){
    document.querySelectorAll('#prayerRows .print-gap-row').forEach(row => row.remove());
  }

  window.addEventListener('beforeprint', function(){
    // run after other beforeprint handlers in same cycle if possible
    addOneVisiblePrintGapRow();
  });

  window.addEventListener('afterprint', removeVisiblePrintGapRow);

  window.addOneVisiblePrintGapRow = addOneVisiblePrintGapRow;
})();
</script>

