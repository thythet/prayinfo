.manager-card{width:min(100%,980px);margin:0 auto;background:#fff;color:#111;border-radius:22px;padding:22px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.light-label{font-weight:700;margin-bottom:7px;display:block}.input-light{width:100%;border:1px solid #d6dde8;border-radius:13px;padding:11px 12px}.section{margin-top:16px;padding-top:14px;border-top:1px solid #e8edf3}.member-row{display:flex;gap:8px;margin-bottom:9px}.member-row input{flex:1}.json-box{background:#0f1724;color:#cfe1ff;border-radius:14px;padding:12px;overflow:auto;font:12px ui-monospace,monospace;max-height:240px}
