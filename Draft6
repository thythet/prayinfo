        const groupLabel = document.createElement("div");
        groupLabel.className = "field-area-group";
        groupLabel.textContent = continent;
        layout.list.appendChild(groupLabel);

        filteredCountries.forEach((country) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "field-area-option";
          btn.textContent = country;
          btn.addEventListener("click", () => {
            if (!canEdit()) return;
            setFieldArea(country);
            closePickers();
          });
          layout.list.appendChild(btn);
        });
      });

      if (!matchCount) {
        const empty = document.createElement("div");
        empty.className = "field-area-empty";
        empty.textContent = "រកមិនឃើញទិន្នន័យ";
        layout.list.appendChild(empty);
      }
    }

    function setFieldArea(value) {
      selectedFieldArea = value;
      desktop.value.textContent = value;
      mobile.value.textContent = value;
      printView.value.textContent = value;
    }

    function closePickers() {
      [desktop, mobile].forEach(layout => {
        layout.picker.classList.remove("open");
        layout.toggle.setAttribute("aria-expanded", "false");
        layout.search.value = "";
      });
    }

    function openPicker(layout) {
      if (!canEdit()) return;
      closePickers();
      layout.picker.classList.add("open");
      layout.toggle.setAttribute("aria-expanded", "true");
      renderFieldAreaOptions(layout, "");
    }

    function createOption(name) {
      const opt = document.createElement("option");
      opt.value = name;
      opt.textContent = name;
      return opt;
    }

    function populateParticipantSelect(layout) {
      layout.select.innerHTML = "";
      const placeholder = document.createElement("option");
      placeholder.value = "";
      placeholder.textContent = "ជ្រើសរើស";
      placeholder.disabled = true;
      placeholder.selected = true;
      layout.select.appendChild(placeholder);

      existingNames.forEach(name => {
        if (!selectedParticipants.includes(name)) layout.select.appendChild(createOption(name));
      });

      const hasRemaining = layout.select.options.length > 1;
      layout.select.classList.toggle("is-hidden", !hasRemaining);
      if (hasRemaining) layout.select.selectedIndex = 0;
    }

    function populateAllParticipantSelects() {
      populateParticipantSelect(desktop);
      populateParticipantSelect(mobile);
    }

    function renderParticipantDisplay(layout) {
      layout.count.textContent = `(${selectedParticipants.length}នាក់)`;
      layout.selected.innerHTML = "";
      if (!selectedParticipants.length) {
        if (layout === desktop) {
          layout.selected.textContent = "សូមជ្រើសឈ្មោះពីបញ្ជី";
          layout.selected.classList.add("empty");
        } else {
          layout.selected.innerHTML = '<span style="color:#5f6772;font-size:14px">សូមជ្រើសឈ្មោះពីបញ្ជី</span>';
        }
        return;
      }
      layout.selected.classList.remove("empty");
      selectedParticipants.forEach(name => {
        const pill = document.createElement("span");
        pill.className = layout === desktop ? "participant-pill" : "m-chip";
        pill.textContent = name;
        layout.selected.appendChild(pill);
      });
    }

    function renderAllParticipants() {
      renderParticipantDisplay(desktop);
      renderParticipantDisplay(mobile);
      printView.count.textContent = `(${selectedParticipants.length}នាក់)`;
      printView.selected.innerHTML = "";
      if (!selectedParticipants.length) {
        printView.selected.textContent = "សូមជ្រើសឈ្មោះពីបញ្ជី";
        printView.selected.classList.add("empty");
      } else {
        printView.selected.classList.remove("empty");
        selectedParticipants.forEach(name => {
          const pill = document.createElement("span");
          pill.className = "participant-pill";
          pill.textContent = name;
          printView.selected.appendChild(pill);
        });
      }
    }

    function ensurePrintRows() {
      while (printView.prayerRows.children.length < MIN_PRAYER_ROWS) {
        const idx = printView.prayerRows.children.length;
        const row = document.createElement("tr");
        row.className = "prayer-row";
        row.innerHTML = `
          <td class="number-col" data-print-number="${idx}"></td>
          <td class="field-cell name-col"><div class="name-display" data-print-name="${idx}"></div></td>
          <td class="field-cell"><textarea data-print-input="${idx}" rows="1" readonly></textarea></td>
        `;
        printView.prayerRows.appendChild(row);
      }
    }

    function ensureDesktopRows() {
      while (desktop.prayerRows.children.length < MIN_PRAYER_ROWS) {
        const idx = desktop.prayerRows.children.length;
        const row = document.createElement("tr");
        row.className = "prayer-row";
        row.innerHTML = `
          <td class="number-col" data-prayer-number="${idx}"></td>
          <td class="field-cell name-col"><div class="name-display" data-prayer-name="${idx}"></div></td>
          <td class="field-cell"><textarea data-prayer-input="${idx}" rows="1"></textarea></td>
        `;
        const ta = row.querySelector("textarea");
        ta.addEventListener("input", () => {
          prayerRequests[idx] = ta.value;
          const mta = mobile.cards.querySelector(`[data-mobile-prayer="${idx}"]`);
          if (mta) mta.value = ta.value;
          autoResizeTextarea(ta);
        });
        desktop.prayerRows.appendChild(row);
      }
    }

    function renderMobileCards() {
      mobile.cards.innerHTML = "";
      const total = Math.max(MIN_PRAYER_ROWS, selectedParticipants.length);
      for (let i = 0; i < total; i++) {
        const card = document.createElement("div");
        card.className = "m-request-card";
        card.innerHTML = `
          <div class="m-request-top">
            <div class="m-request-no">លេខ ${selectedParticipants[i] ? i + 1 : "-"}</div>
            <div class="m-request-name">${selectedParticipants[i] || "គ្មានឈ្មោះ"}</div>
          </div>
          <textarea class="m-textarea" data-mobile-prayer="${i}" placeholder="សំណូមពរ..."></textarea>
        `;
        const ta = card.querySelector("textarea");
        ta.value = prayerRequests[i] || "";
        ta.addEventListener("input", () => {
          prayerRequests[i] = ta.value;
          const dta = desktop.prayerRows.querySelector(`[data-prayer-input="${i}"]`);
          if (dta) {
            dta.value = ta.value;
            autoResizeTextarea(dta);
          }
        });
        mobile.cards.appendChild(card);
      }
    }

    function renderPrayerRows() {
      ensureDesktopRows();
      ensurePrintRows();
      const total = Math.max(MIN_PRAYER_ROWS, selectedParticipants.length);
      const rows = desktop.prayerRows.querySelectorAll(".prayer-row");
      rows.forEach((row, i) => {
        row.querySelector('[data-prayer-number]').textContent = selectedParticipants[i] ? i + 1 : "";
        row.querySelector('[data-prayer-name]').textContent = selectedParticipants[i] || "";
        const ta = row.querySelector('[data-prayer-input]');
        ta.value = prayerRequests[i] || "";
        autoResizeTextarea(ta);
        row.style.display = i < total ? "" : "none";
      });

      const printRows = printView.prayerRows.querySelectorAll(".prayer-row");
      printRows.forEach((row, i) => {
        row.querySelector('[data-print-number]').textContent = selectedParticipants[i] ? i + 1 : "";
        row.querySelector('[data-print-name]').textContent = selectedParticipants[i] || "";
        const ta = row.querySelector('[data-print-input]');
        ta.value = prayerRequests[i] || "";
        autoResizeTextarea(ta);
        row.style.display = i < total ? "" : "none";
      });

      renderMobileCards();
    }

    function addSelectedParticipant(name) {
      const clean = name.trim();
      if (!clean || !canEdit()) return;
      if (!selectedParticipants.includes(clean)) selectedParticipants.push(clean);
      populateAllParticipantSelects();
      renderAllParticipants();
      renderPrayerRows();
    }

    function autoResizeTextarea(textarea) {
      textarea.style.height = "auto";
      textarea.style.height = `${Math.max(textarea.scrollHeight, 52)}px`;
    }

    function collectFormData() {
      const source = activeLayout();
      syncTextFields(source);
      return {
        fieldArea: selectedFieldArea,
        pastorName: desktop.pastor.value.trim(),
        currentDate: desktop.date.value || "",
        participants: [...selectedParticipants],
        prayerRequests: [...prayerRequests],
        specialNote: desktop.special.value.trim(),
        offering: desktop.offering.value.trim(),
        updatedAt: Date.now(),
        createdBy: currentUser?.email || ""
      };
    }

    function fillForm(data = {}) {
      selectedFieldArea = data.fieldArea || "វៀតណាម";
      setFieldArea(selectedFieldArea);
      desktop.pastor.value = data.pastorName || "";
      mobile.pastor.value = data.pastorName || "";
      desktop.date.value = data.currentDate || "";
      mobile.date.value = data.currentDate || "";
      desktop.special.value = data.specialNote || "";
      mobile.special.value = data.specialNote || "";
      printView.special.value = data.specialNote || "";
      desktop.offering.value = data.offering || "";
      mobile.offering.value = data.offering || "";
      printView.offering.value = data.offering || "";
      printView.pastor.value = data.pastorName || "";
      printView.date.value = data.currentDate || "";
      printView.value.textContent = selectedFieldArea;
      selectedParticipants = Array.isArray(data.participants) ? [...data.participants] : [];
      prayerRequests = Array.from({length: Math.max(MIN_PRAYER_ROWS, (data.prayerRequests || []).length)}, (_, i) => (data.prayerRequests && data.prayerRequests[i]) || "");
      populateAllParticipantSelects();
      renderAllParticipants();
      renderPrayerRows();
      emptyState.classList.add("hidden");
      pageShell.classList.remove("hidden");
      updateAccess();
    }

    function clearForm() {
      currentEntryId = null;
      setFieldArea("វៀតណាម");
      desktop.pastor.value = mobile.pastor.value = "";
      const today = new Date().toISOString().slice(0,10);
      desktop.date.value = mobile.date.value = printView.date.value = today;
      desktop.special.value = mobile.special.value = printView.special.value = "";
      desktop.offering.value = mobile.offering.value = printView.offering.value = "";
      printView.pastor.value = "";
      selectedParticipants = [];
      prayerRequests = Array(MIN_PRAYER_ROWS).fill("");
      populateAllParticipantSelects();
      renderAllParticipants();
      renderPrayerRows();
      emptyState.classList.add("hidden");
      pageShell.classList.remove("hidden");
      updateAccess();
      setStatus(appStatus, "");
      highlightActiveCard(null);
    }

    function updateAccess() {
      const editable = canEdit();
      pageShell.classList.toggle("readonly", !editable);
      [desktop.pastor, desktop.date, desktop.special, desktop.offering, mobile.pastor, mobile.date, mobile.special, mobile.offering].forEach(el => {
        el.readOnly = !editable;
        el.disabled = false;
      });
      desktop.toggle.disabled = !editable;
      mobile.toggle.disabled = !editable;
      saveBtn.classList.toggle("hidden", !editable);
      deleteBtn.classList.toggle("hidden", !editable || !currentEntryId);
      newEntryBtn.classList.toggle("hidden", !editable);
      roleTag.innerHTML = currentRole === "admin"
        ? '<i class="ri-shield-star-line"></i> admin'
        : currentRole === "editor"
          ? '<i class="ri-edit-2-line"></i> editor'
          : '<i class="ri-eye-line"></i> viewer';
      accessNote.textContent = editable ? `${currentRole} mode: can create and edit` : "viewer mode: can only see and export PDF";
      desktop.prayerRows.querySelectorAll('textarea').forEach(t => t.readOnly = !editable);
      mobile.cards.querySelectorAll('textarea').forEach(t => t.readOnly = !editable);
    }

    function formatDate(value) {
      if (!value) return "--/--/----";
      const d = new Date(value);
      if (isNaN(d.getTime())) return value;
      return `${String(d.getDate()).padStart(2, "0")}/${String(d.getMonth() + 1).padStart(2, "0")}/${d.getFullYear()}`;
    }

    function renderList() {
      const q = searchInput.value.trim().toLowerCase();
      const items = Object.entries(entriesMap)
        .map(([id, data]) => ({ id, ...data }))
        .sort((a, b) => (b.updatedAt || 0) - (a.updatedAt || 0))
        .filter(item => (`${item.fieldArea || ""} ${item.pastorName || ""} ${item.currentDate || ""}`).toLowerCase().includes(q));

      entryList.innerHTML = "";
      if (!items.length) {
        entryList.innerHTML = '<div class="entry-meta">No records found.</div>';
        return;
      }

      items.forEach(item => {
        const card = document.createElement("div");
        card.className = "entry-card";
        card.dataset.id = item.id;
        card.innerHTML = `
          <div class="entry-name">${item.fieldArea || "No field area"}</div>
          <div class="entry-id">${item.pastorName || "No pastor"}</div>
          <div class="entry-meta">Date: ${formatDate(item.currentDate)} • ${item.participants ? item.participants.length : 0} participants</div>
        `;
        if (item.id === currentEntryId) card.classList.add("active");
        card.addEventListener("click", () => {
          currentEntryId = item.id;
          fillForm(item);
          highlightActiveCard(item.id);
        });
        entryList.appendChild(card);
      });
    }

    function highlightActiveCard(id) {
      document.querySelectorAll(".entry-card").forEach(card => {
        card.classList.toggle("active", card.dataset.id === id);
      });
    }

    async function saveCurrent() {
      if (!canEdit()) return;
      const data = collectFormData();
      if (!data.fieldArea || !data.currentDate) {
        setStatus(appStatus, "Please choose field area and date.");
        return;
      }
      try {
        if (currentEntryId) {
          const existing = entriesMap[currentEntryId] || {};
          await set(ref(db, `prayinfoEntries/${currentEntryId}`), { ...existing, ...data });
          setStatus(appStatus, "Updated successfully.", true);
        } else {
          const newRef = push(ref(db, "prayinfoEntries"));
          await set(newRef, { ...data, createdAt: Date.now() });
          currentEntryId = newRef.key;
          setStatus(appStatus, "Saved successfully.", true);
        }
      } catch (err) {
        setStatus(appStatus, err.message || "Save failed.");
      }
    }

    async function deleteCurrent() {
      if (!canEdit() || !currentEntryId) return;
      if (!confirm("Delete this form?")) return;
      try {
        await remove(ref(db, `prayinfoEntries/${currentEntryId}`));
        currentEntryId = null;
        pageShell.classList.add("hidden");
        emptyState.classList.remove("hidden");
        setStatus(appStatus, "Deleted.", true);
      } catch (err) {
        setStatus(appStatus, err.message || "Delete failed.");
      }
    }

    function exportPdf() {
      if (pageShell.classList.contains("hidden")) {
        setStatus(appStatus, "Please open a form first.");
        return;
      }
      window.print();
    }

    function subscribeEntries() {
      onValue(ref(db, "prayinfoEntries"), snap => {
        entriesMap = snap.val() || {};
        renderList();
        if (currentEntryId && entriesMap[currentEntryId]) fillForm(entriesMap[currentEntryId]);
      });
    }

    function bindPicker(layout) {
      layout.toggle.addEventListener("click", () => {
        if (layout.picker.classList.contains("open")) {
          closePickers();
        } else {
          openPicker(layout);
        }
      });
      layout.search.addEventListener("input", () => renderFieldAreaOptions(layout, layout.search.value));
    }

    bindPicker(desktop);
    bindPicker(mobile);

    document.addEventListener("click", (event) => {
      if (!desktop.picker.contains(event.target) && !mobile.picker.contains(event.target)) closePickers();
    });

    bindMirror(desktop);
    bindMirror(mobile);

    desktop.select.addEventListener("change", () => addSelectedParticipant(desktop.select.value));
    mobile.select.addEventListener("change", () => addSelectedParticipant(mobile.select.value));

    desktop.addBtn.addEventListener("click", () => {
      if (!canEdit()) return;
      const newName = prompt("បញ្ចូលឈ្មោះថ្មី");
      if (!newName) return;
      const clean = newName.trim();
      if (!clean) return;
      if (!existingNames.includes(clean)) existingNames.push(clean);
      addSelectedParticipant(clean);
    });
    mobile.addBtn.addEventListener("click", () => desktop.addBtn.click());

    loginBtn.addEventListener("click", async () => {
      try {
        setStatus(loginStatus, "Logging in...");
        await signInWithEmailAndPassword(auth, loginEmail.value.trim(), loginPassword.value);
      } catch (err) {
        setStatus(loginStatus, err.message || "Login failed.");
      }
    });

    logoutBtn.addEventListener("click", async () => {
      await signOut(auth);
    });

    newEntryBtn.addEventListener("click", clearForm);
    saveBtn.addEventListener("click", saveCurrent);
    deleteBtn.addEventListener("click", deleteCurrent);
    exportPdfBtn.addEventListener("click", exportPdf);
    desktop.printBtn.addEventListener("click", exportPdf);
    mobile.printBtn.addEventListener("click", exportPdf);
    desktop.resetBtn.addEventListener("click", clearForm);
    mobile.resetBtn.addEventListener("click", clearForm);
    searchInput.addEventListener("input", renderList);

    onAuthStateChanged(auth, async (user) => {
      currentUser = user;
      if (!user) {
        loginScreen.classList.remove("hidden");
        appScreen.classList.add("hidden");
        return;
      }
      currentRole = await getUserRole(user);
      loginScreen.classList.add("hidden");
      appScreen.classList.remove("hidden");
      userLabel.textContent = `${user.email} • ${currentRole}`;
      updateAccess();
      subscribeEntries();
      if (!currentEntryId) {
        pageShell.classList.add("hidden");
        emptyState.classList.remove("hidden");
      }
    });

    populateAllParticipantSelects();
    setFieldArea("វៀតណាម");
    const today = new Date().toISOString().slice(0,10);
    desktop.date.value = mobile.date.value = today;
    renderAllParticipants();
    renderPrayerRows();
  </script>
</body>
</html>
