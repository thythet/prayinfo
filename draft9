  transform:scale(calc((100vw - 42px) / 900));
}
}
.print-only{display:none}@media print{body{background:#fff}.app,.login-wrap{display:none!important}.print-only{display:block}.paper{width:100%;box-shadow:none;padding:0}}

/* Fix participant controls alignment */
.select-row{display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:10px!important;width:100%!important;}
#selectedParticipant{flex:1 1 auto!important;min-width:220px!important;}
#participantSelect{width:150px!important;min-width:150px!important;}
#addParticipantBtn{white-space:nowrap!important;}
@media(max-width:760px){.select-row{justify-content:flex-start!important;flex-wrap:wrap!important;}#selectedParticipant{flex:1 1 100%!important;min-width:0!important;}}


/* ===== Dashboard clear activity button ===== */
.dash-head-actions,
.panel-head-actions{
  display:flex!important;
  justify-content:space-between!important;
  align-items:center!important;
  gap:10px!important;
}
.clear-activity-btn{
  background:rgba(255,80,80,.18)!important;
  border:1px solid rgba(255,80,80,.35)!important;
