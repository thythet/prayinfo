<body>
<div id="loginScreen" class="login-wrap">
  <div class="login-card glass">
    <div class="brand"><i class="ri-file-list-3-line"></i><span>PrayInfo</span></div>
    <p style="color:var(--muted);line-height:1.7">Login with Firebase Email/Password.</p>
    <div class="field"><label>Email</label><input id="loginEmail" class="input-dark" type="email"></div>
    <div class="field"><label>Password</label><input id="loginPassword" class="input-dark" type="password"></div>
    <button id="loginBtn" class="btn primary">Login</button>
    <div id="loginStatus" class="status"></div>
  </div>
</div>

<div id="app" class="app hidden">
  <div class="nav glass">
    <div class="nav-left"><i class="ri-stack-line"></i> PrayInfo</div>
    <div class="nav-center">
      <button class="nav-tab active" data-page="form">Form</button>
      <button id="navManager" class="nav-tab hidden" data-page="manager">Manager</button>
      <button id="navDashboard" class="nav-tab hidden" data-page="dashboard">Dashboard</button>
    </div>
    <div class="nav-right"><span id="userInfo"></span><button id="logoutBtn" class="btn small">Logout</button></div>
  </div>

  <section id="pageForm" class="page active">
    <div class="layout">
      <div class="panel glass">
        <div class="panel-head"><h3>Saved Entries</h3><div class="card-meta">Click to open</div></div>
        <div class="panel-body">
          <div class="search"><i class="ri-search-eye-line"></i><input id="entrySearch" class="input-dark" placeholder="Search..."></div>
          <div id="entryList" class="list"></div>
        </div>
      </div>
      <div class="panel glass">
        <div class="workspace">
          <div class="toolbar">
            <div id="modeText" class="card-meta">Viewer mode</div>
            <div class="btn-row">
              <button id="newEntryBtn" class="btn primary hidden">New</button>
              <button id="saveEntryBtn" class="btn primary hidden">Save</button>
              <button id="deleteEntryBtn" class="btn danger hidden">Delete</button>
              <button id="exportBtn" class="btn">Export PDF</button>
            </div>
          </div>
          <div id="emptyForm" class="empty"><i class="ri-file-paper-2-line"></i><div>Select entry or create new form.</div></div>
          <div id="formBox" class="shell hidden"></div>
          <div id="formStatus" class="status"></div>
        </div>
      </div>
    </div>
  </section>

  <section id="pageManager" class="page">
    <div class="layout">
      <div class="panel glass"><div class="panel-head"><h3>Field Areas</h3><div class="card-meta">Admin only</div></div><div class="panel-body"><div class="search"><i class="ri-search-eye-line"></i><input id="areaSearch" class="input-dark" placeholder="Search..."></div><div id="areaList" class="list"></div></div></div>
      <div class="panel glass"><div class="workspace"><div class="toolbar"><div class="card-meta">Database manager</div><div class="btn-row"><button id="newAreaBtn" class="btn primary">New Area</button><button id="saveAreaBtn" class="btn primary">Save</button><button id="deleteAreaBtn" class="btn danger hidden">Delete</button></div></div><div id="managerBox" class="shell"></div><div id="managerStatus" class="status"></div></div></div>
    </div>
  </section>

  <section id="pageDashboard" class="page">
    <div class="stats"><div class="stat glass"><small>Entries</small><b id="statEntries">0</b></div><div class="stat glass"><small>Field Areas</small><b id="statAreas">0</b></div><div class="stat glass"><small>Members</small><b id="statMembers">0</b></div><div class="stat glass"><small>Logs</small><b id="statLogs">0</b></div></div>
    <div class="dash-grid"><div class="panel glass"><div class="panel-head panel-head-actions"><h3>Recent Activity</h3><button id="clearActivityBtn" class="clear-activity-btn">Clear Activity</button></div><div class="panel-body"><div id="activityList" class="list"></div></div></div><div class="panel glass"><div class="panel-head"><h3>Overview</h3></div><div class="panel-body card-meta">Dashboard stats update from Firebase.</div></div></div>
  </section>
</div>

<div id="printArea" class="print-only"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getDatabase, ref, onValue, get, push, set, remove } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

const firebaseConfig={apiKey:"AIzaSyCnY3d8RMsKDKcBVZQso-sI67Kh5jNiQMM",authDomain:"thythet-prayinfo.firebaseapp.com",databaseURL:"https://thythet-prayinfo-default-rtdb.asia-southeast1.firebasedatabase.app",projectId:"thythet-prayinfo",storageBucket:"thythet-prayinfo.firebasestorage.app",messagingSenderId:"118558680253",appId:"1:118558680253:web:1a15f0dbfdf293e7c5c3d4"};
const ADMIN_UID="tbZLZ0VJE2PHk3XS2QWwzqRLitd2";
const app=initializeApp(firebaseConfig),auth=getAuth(app),db=getDatabase(app);
const $=id=>document.getElementById(id);
let user=null,role="viewer",fieldAreas={},entries={},auditLogs={},currentEntryId=null,currentAreaId=null,selectedAreaId="",selectedParticipants=[],availableMembers=[],prayerRequests=[];

function canEdit(){return role==="admin"||role==="editor"} function isAdmin(){return role==="admin"}
function status(el,t,good=false){el.textContent=t||"";el.style.color=good?"var(--success)":"var(--muted)"}
async function getRole(u){if(!u)return"viewer";if(u.uid===ADMIN_UID)return"admin";const s=await get(ref(db,`allowedUsers/${u.uid}/role`));return s.exists()?s.val():"viewer"}
function log(action,id,data){if(!user)return;push(ref(db,"auditLogs"),{action,entryId:id||"",fieldArea:data?.fieldArea||data?.name||"",user:{uid:user.uid,email:user.email,role},timestamp:Date.now()})}

$("loginBtn").onclick=async()=>{try{status($("loginStatus"),"Logging in...");await signInWithEmailAndPassword(auth,$("loginEmail").value.trim(),$("loginPassword").value)}catch(e){status($("loginStatus"),e.message)}};
$("logoutBtn").onclick=()=>signOut(auth);
document.querySelectorAll(".nav-tab").forEach(b=>b.onclick=()=>showPage(b.dataset.page));
function showPage(p){document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));$("page"+p[0].toUpperCase()+p.slice(1)).classList.add("active");document.querySelectorAll(".nav-tab").forEach(x=>x.classList.toggle("active",x.dataset.page===p));}

onAuthStateChanged(auth,async u=>{user=u;if(!u){$("loginScreen").classList.remove("hidden");$("app").classList.add("hidden");return}role=await getRole(u);$("loginScreen").classList.add("hidden");$("app").classList.remove("hidden");$("userInfo").textContent=`${u.email} • ${role}`;$("navManager").classList.toggle("hidden",!isAdmin());$("navDashboard").classList.toggle("hidden",!isAdmin());updateAccess();subscribe();});

function subscribe(){onValue(ref(db,"fieldAreas"),s=>{fieldAreas=s.val()||{};renderEntryList();renderAreaList();renderStats()});onValue(ref(db,"prayinfoEntries"),s=>{entries=s.val()||{};renderEntryList();renderStats()});onValue(ref(db,"auditLogs"),s=>{auditLogs=s.val()||{};renderStats();renderLogs()})}
function updateAccess(){$("newEntryBtn").classList.toggle("hidden",!canEdit());$("saveEntryBtn").classList.toggle("hidden",!canEdit());$("deleteEntryBtn").classList.toggle("hidden",!isAdmin()||!currentEntryId);$("modeText").textContent=canEdit()?`${role} mode: can edit`:"viewer mode: view/export only"}


function fitMobilePaper(){
  const formBox = $("formBox");
  const paper = formBox?.querySelector(".paper");
  if(!formBox || !paper) return;
  if(window.innerWidth > 760){
    paper.style.transform = "";
    paper.style.width = "";
    paper.style.maxWidth = "";
    formBox.style.height = "";
    return;
  }
  const boxWidth = Math.max(280, formBox.clientWidth - 2);
  const baseWidth = 900;
  const scale = Math.min(1, boxWidth / baseWidth);
  paper.style.width = baseWidth + "px";
  paper.style.maxWidth = baseWidth + "px";
  paper.style.transform = `scale(${scale})`;
  paper.style.transformOrigin = "top left";
  formBox.style.height = (paper.scrollHeight * scale + 20) + "px";
  formBox.style.overflow = "hidden";
}
window.addEventListener("resize", fitMobilePaper);

function formHTML(){return `<main class="paper"><h1>ពួកជំនុំតាមផ្ទះ</h1><section class="subhead"><div><label class="inline"><span>វាលស្មៅ៖</span><div class="field-picker" id="fieldPicker"><button type="button" class="field-toggle" id="fieldToggle"><span id="fieldValue">ជ្រើសរើស</span> <i class="ri-arrow-down-s-line"></i></button><div class="field-panel"><input id="fieldSearch" class="field-search" placeholder="ស្វែងរក..."><div id="fieldList" class="field-list"></div></div></div></label></div><div class="center"><label class="inline"><span>អ្នកគង្វាល៖</span><input id="pastorName" class="line-input" readonly></label></div><div class="right"><label class="inline"><span>កាលបរិច្ឆេទ៖</span><input id="currentDate" class="line-input date-input" type="date"></label></div></section><table><colgroup><col style="width:150px"><col></colgroup><tr><td class="label-cell">អ្នកចូលរួម <span class="participant-count" id="participantCount">(0នាក់)</span></td><td class="field-cell"><div class="participant-wrap"><span>ឈ្មោះ៖</span><div style="flex:1"><div id="selectedParticipant" class="selected-participant">សូមជ្រើសឈ្មោះពីបញ្ជី</div><div class="select-row"><select id="participantSelect"></select><button type="button" id="addParticipantBtn" class="add-btn">+ Add</button></div></div></div></td></tr><tr><td colspan="2"><table class="inner-table"><colgroup><col style="width:66px"><col style="width:250px"><col></colgroup><thead><tr class="prayer-header"><th class="number-col">លេខ</th><th class="name-col">ឈ្មោះ</th><th>សំណូមពរ</th></tr></thead><tbody id="prayerRows"></tbody></table></td></tr><tr><td class="label-cell">រឿងពិសេស</td><td class="field-cell single-line"><textarea id="specialNote"></textarea></td></tr><tr><td class="label-cell">ដង្វាយ</td><td class="field-cell single-line"><textarea id="offering"></textarea></td></tr></table></main>`}
function openNewForm(){currentEntryId=null;selectedAreaId="";selectedParticipants=[];availableMembers=[];prayerRequests=Array(12).fill("");$("formBox").innerHTML=formHTML();$("emptyForm").classList.add("hidden");$("formBox").classList.remove("hidden");$("currentDate").value=new Date().toISOString().slice(0,10);bindForm();updateAccess();setTimeout(fitMobilePaper,50)}
$("newEntryBtn").onclick=openNewForm;
function bindForm(){
  renderFields();
  renderParticipants();
  renderRows();
  $("fieldToggle").onclick=()=>$("fieldPicker").classList.toggle("open");
  $("fieldSearch").oninput=()=>renderFields($("fieldSearch").value);
  $("participantSelect").onchange=()=>{
    let n=$("participantSelect").value;
    if(n && !selectedParticipants.includes(n)){
      selectedParticipants.push(n);
      renderParticipants();
      renderRows();
    }
  };
  $("addParticipantBtn").onclick=()=>{
    let n=$("participantSelect").value;
    if(!n){
      n=prompt("បញ្ចូលឈ្មោះថ្មី");
      if(n){
        n=n.trim();
        if(n && !availableMembers.includes(n)) availableMembers.push(n);
      }
    }
    if(n && !selectedParticipants.includes(n)){
      selectedParticipants.push(n);
      renderParticipants();
      renderRows();
    }
  };
}
function renderFields(q=""){let list=$("fieldList");if(!list)return;list.innerHTML="";Object.entries(fieldAreas).filter(([id,a])=>(a.name||"").toLowerCase().includes(q.toLowerCase())).forEach(([id,a])=>{let b=document.createElement("button");b.className="field-option";b.textContent=a.name;b.onclick=()=>selectArea(id);list.appendChild(b)})}
function selectArea(id){let a=fieldAreas[id];if(!a)return;selectedAreaId=id;$("fieldValue").textContent=a.name;$("pastorName").value=a.pastorName||"";$("fieldPicker").classList.remove("open");availableMembers=Object.values(a.members||{}).map(m=>m.name).filter(Boolean);selectedParticipants=[];prayerRequests=Array(12).fill("");renderParticipants();renderRows()}
function renderParticipants(){if(!$("participantCount"))return;$("participantCount").textContent=`(${selectedParticipants.length}នាក់)`;$("selectedParticipant").innerHTML=selectedParticipants.length?selectedParticipants.map(n=>`<span class="pill">${n}</span>`).join(""):"សូមជ្រើសឈ្មោះពីបញ្ជី";let sel=$("participantSelect");sel.innerHTML='<option value="">ជ្រើសរើស</option>';availableMembers.filter(n=>!selectedParticipants.includes(n)).forEach(n=>{let o=document.createElement("option");o.value=n;o.textContent=n;sel.appendChild(o)})}
function renderRows(){let body=$("prayerRows");if(!body)return;body.innerHTML="";let total=Math.max(12,selectedParticipants.length);for(let i=0;i<total;i++){let tr=document.createElement("tr");tr.className="prayer-row";tr.innerHTML=`<td class="number-col">${selectedParticipants[i]?i+1:""}</td><td class="name-col"><div class="name-display">${selectedParticipants[i]||""}</div></td><td class="field-cell"><textarea data-i="${i}"></textarea></td>`;let ta=tr.querySelector("textarea");ta.value=prayerRequests[i]||"";ta.disabled=!canEdit();ta.oninput=()=>prayerRequests[i]=ta.value;body.appendChild(tr)}setTimeout(fitMobilePaper,30);["currentDate","specialNote","offering"].forEach(id=>$(id).disabled=!canEdit());$("participantSelect").disabled=!canEdit();$("addParticipantBtn").style.display=canEdit()?"":"none"}
function collect(){
  let a=fieldAreas[selectedAreaId]||{};
  let fieldText=(a.name || $("fieldValue")?.textContent || "").trim();
  let pastorText=(a.pastorName || $("pastorName")?.value || "").trim();
  return{fieldAreaId:selectedAreaId||"",fieldArea:fieldText,pastorName:pastorText,currentDate:$("currentDate")?.value||"",participants:[...selectedParticipants],prayerRequests:[...prayerRequests],specialNote:$("specialNote")?.value||"",offering:$("offering")?.value||"",updatedAt:Date.now(),updatedBy:user?.email||""}
}
$("saveEntryBtn").onclick=async()=>{if(!canEdit())return;let d=collect();if(!d.fieldArea||!d.currentDate){status($("formStatus"),"Choose field area and date.");return}if(currentEntryId){await set(ref(db,`prayinfoEntries/${currentEntryId}`),{...(entries[currentEntryId]||{}),...d});log("update",currentEntryId,d);status($("formStatus"),"Updated.",true)}else{let r=push(ref(db,"prayinfoEntries"));currentEntryId=r.key;await set(r,{...d,createdAt:Date.now(),createdBy:user.email});log("create",currentEntryId,d);status($("formStatus"),"Saved.",true)}updateAccess()}
$("deleteEntryBtn").onclick=async()=>{if(!isAdmin()||!currentEntryId)return;if(!confirm("Delete this entry?"))return;let old=entries[currentEntryId];await set(ref(db,`deletedEntries/${currentEntryId}`),{...old,deletedAt:Date.now(),deletedBy:user.email});await remove(ref(db,`prayinfoEntries/${currentEntryId}`));log("delete",currentEntryId,old);currentEntryId=null;$("formBox").classList.add("hidden");$("emptyForm").classList.remove("hidden");updateAccess()}
function openEntry(id){
  let e=entries[id];
  if(!e)return;
  currentEntryId=id;
  $("formBox").innerHTML=formHTML();
  $("emptyForm").classList.add("hidden");
  $("formBox").classList.remove("hidden");
  bindForm();
  selectedAreaId=e.fieldAreaId||"";
  if(!selectedAreaId && e.fieldArea){
    let found=Object.entries(fieldAreas).find(([fid,a])=>(a.name||"")===e.fieldArea);
    if(found) selectedAreaId=found[0];
  }
  availableMembers=Object.values(fieldAreas[selectedAreaId]?.members||{}).map(m=>m.name).filter(Boolean);
  selectedParticipants=Array.isArray(e.participants)?[...e.participants]:[];
  // Include saved participant names in available list so edit view can still show them
  selectedParticipants.forEach(n=>{if(n && !availableMembers.includes(n)) availableMembers.push(n)});
  prayerRequests=Array.from({length:Math.max(12,(e.prayerRequests||[]).length)},(_,i)=>(e.prayerRequests||[])[i]||"");
  $("fieldValue").textContent=e.fieldArea||fieldAreas[selectedAreaId]?.name||"";
  $("pastorName").value=e.pastorName||fieldAreas[selectedAreaId]?.pastorName||"";
  $("currentDate").value=e.currentDate||"";
  $("specialNote").value=e.specialNote||"";
  $("offering").value=e.offering||"";
  renderParticipants();
  renderRows();
  updateAccess();
  renderEntryList();
  setTimeout(fitMobilePaper,50)
}
function renderEntryList(){let q=($("entrySearch").value||"").toLowerCase();let arr=Object.entries(entries).map(([id,d])=>({id,...d})).filter(e=>(`${e.fieldArea||""} ${e.pastorName||""}`).toLowerCase().includes(q)).sort((a,b)=>(b.updatedAt||b.createdAt||0)-(a.updatedAt||a.createdAt||0));$("entryList").innerHTML=arr.length?"":"<div class='card-meta'>No entries.</div>";arr.forEach(e=>{let div=document.createElement("div");div.className="card-list"+(e.id===currentEntryId?" active":"");div.innerHTML=`<div style="display:flex;justify-content:space-between;gap:8px"><div><div class="card-title">${e.fieldArea||"No area"}</div><div class="card-meta">${e.currentDate||""} • ${e.pastorName||""} • ${(e.participants||[]).length}នាក់</div></div><button class="btn small">Open</button></div>`;div.onclick=()=>openEntry(e.id);$("entryList").appendChild(div)})}
$("entrySearch").oninput=renderEntryList;
$("exportBtn").onclick=()=>{if(!$("formBox").innerHTML){status($("formStatus"),"Open form first.");return}let d=collect();$("printArea").innerHTML=formHTML();setTimeout(()=>{let pv=$("printArea");pv.querySelector("#fieldValue").textContent=d.fieldArea;pv.querySelector("#pastorName").value=d.pastorName;pv.querySelector("#currentDate").value=d.currentDate;pv.querySelector("#selectedParticipant").innerHTML=d.participants.map(n=>`<span class="pill">${n}</span>`).join("");pv.querySelector("#participantCount").textContent=`(${d.participants.length}នាក់)`;let body=pv.querySelector("#prayerRows");body.innerHTML="";for(let i=0;i<Math.max(12,d.participants.length);i++){body.insertAdjacentHTML("beforeend",`<tr class="prayer-row"><td class="number-col">${d.participants[i]?i+1:""}</td><td class="name-col"><div class="name-display">${d.participants[i]||""}</div></td><td class="field-cell"><textarea>${d.prayerRequests[i]||""}</textarea></td></tr>`)}pv.querySelector("#specialNote").value=d.specialNote;pv.querySelector("#offering").value=d.offering;window.print()},50)};

function renderAreaManager(){if(!isAdmin())return;$("managerBox").innerHTML=`<div class="manager-card"><div class="grid2"><div><label class="light-label">Field Area</label><input id="areaName" class="input-light"></div><div><label class="light-label">Pastor</label><input id="areaPastor" class="input-light"></div></div><div class="section"><h3>Members</h3><div class="btn-row"><button id="addMember" class="btn small primary">Add</button><button id="pasteMembers" class="btn small">Paste List</button></div><br><div id="membersBox"></div></div><pre id="preview" class="json-box">{}</pre></div>`;$("addMember").onclick=()=>addMemberRow("");$("pasteMembers").onclick=()=>{let raw=prompt("Paste names, one per line");if(!raw)return;$("membersBox").innerHTML="";raw.split("\\n").map(x=>x.trim()).filter(Boolean).forEach(addMemberRow);preview()};["areaName","areaPastor"].forEach(id=>$(id).oninput=preview);addMemberRow("");preview()}
function addMemberRow(v){let row=document.createElement("div");row.className="member-row";row.innerHTML=`<input class="input-light mem" value="${(v||"").replaceAll('"','&quot;')}"><button class="btn small danger">x</button>`;row.querySelector("button").onclick=()=>{row.remove();preview()};row.querySelector("input").oninput=preview;$("membersBox").appendChild(row)}
function collectArea(){let members={};[...document.querySelectorAll(".mem")].map(i=>i.value.trim()).filter(Boolean).forEach((name,i)=>members[`member_${String(i+1).padStart(3,"0")}`]={name});return{name:$("areaName")?.value.trim()||"",pastorName:$("areaPastor")?.value.trim()||"",members,updatedAt:Date.now()}}
function preview(){if($("preview"))$("preview").textContent=JSON.stringify(collectArea(),null,2)}
function renderAreaList(){if(!isAdmin())return;let q=($("areaSearch").value||"").toLowerCase();let arr=Object.entries(fieldAreas).map(([id,d])=>({id,...d})).filter(a=>(`${a.name||""} ${a.pastorName||""}`).toLowerCase().includes(q));$("areaList").innerHTML=arr.length?"":"<div class='card-meta'>No areas.</div>";arr.forEach(a=>{let div=document.createElement("div");div.className="card-list";div.innerHTML=`<div class="card-title">${a.name}</div><div class="card-meta">Pastor: ${a.pastorName} • ${Object.keys(a.members||{}).length} members</div>`;div.onclick=()=>openArea(a.id);$("areaList").appendChild(div)})}
$("areaSearch").oninput=renderAreaList;$("newAreaBtn").onclick=()=>{currentAreaId=null;renderAreaManager();$("deleteAreaBtn").classList.add("hidden")};
function openArea(id){currentAreaId=id;renderAreaManager();let a=fieldAreas[id];$("areaName").value=a.name||"";$("areaPastor").value=a.pastorName||"";$("membersBox").innerHTML="";Object.values(a.members||{}).forEach(m=>addMemberRow(m.name));$("deleteAreaBtn").classList.remove("hidden");preview()}
$("saveAreaBtn").onclick=async()=>{if(!isAdmin())return;let d=collectArea();if(!d.name||!d.pastorName){status($("managerStatus"),"Enter field area and pastor.");return}if(currentAreaId){await set(ref(db,`fieldAreas/${currentAreaId}`),{...(fieldAreas[currentAreaId]||{}),...d});status($("managerStatus"),"Updated.",true)}else{let r=push(ref(db,"fieldAreas"));currentAreaId=r.key;await set(r,{...d,createdAt:Date.now()});status($("managerStatus"),"Saved.",true)}};
$("deleteAreaBtn").onclick=async()=>{if(!isAdmin()||!currentAreaId)return;if(confirm("Delete area?")){await remove(ref(db,`fieldAreas/${currentAreaId}`));currentAreaId=null;renderAreaManager();$("deleteAreaBtn").classList.add("hidden")}};

function renderStats(){$("statEntries").textContent=Object.keys(entries).length;$("statAreas").textContent=Object.keys(fieldAreas).length;$("statMembers").textContent=Object.values(fieldAreas).reduce((s,a)=>s+Object.keys(a.members||{}).length,0);$("statLogs").textContent=Object.keys(auditLogs).length}
function renderLogs(){let arr=Object.values(auditLogs).sort((a,b)=>(b.timestamp||0)-(a.timestamp||0)).slice(0,30);$("activityList").innerHTML=arr.length?"":"<div class='card-meta'>No logs.</div>";arr.forEach(l=>{let div=document.createElement("div");div.className="card-list";div.innerHTML=`<div class="card-title">${(l.action||"").toUpperCase()} • ${l.fieldArea||""}</div><div class="card-meta">${l.user?.email||""} • ${new Date(l.timestamp||Date.now()).toLocaleString()}</div>`;$("activityList").appendChild(div)})}
renderAreaManager();
</script>

<script>
(function(){
  function getFirebaseDbCompat(){
    try{
      if(window.firebase && firebase.database) return firebase.database();
    }catch(e){}
    return null;
  }

  function getCurrentUserEmail(){
    try{
      if(window.firebase && firebase.auth && firebase.auth().currentUser){
        return firebase.auth().currentUser.email || "";
      }
    }catch(e){}
    const userInfo = document.getElementById("userInfo") || document.getElementById("navUser");
    return userInfo ? userInfo.textContent : "";
  }

  async function clearActivityLogs(){
    const emailText = getCurrentUserEmail();
    if(!emailText.includes("thythet455@gmail.com")){
      alert("Admin only.");
      return;
    }

    const ok = confirm("Clear all activity logs? This will delete auditLogs from Firebase.");
    if(!ok) return;

    try{
      const compatDb = getFirebaseDbCompat();
      if(compatDb){
        await compatDb.ref("auditLogs").remove();
      }else if(window.db && window.ref && window.remove){
        await window.remove(window.ref(window.db, "auditLogs"));
      }else{
        alert("Firebase database is not available.");
        return;
      }

      const activityList = document.getElementById("activityList");
      if(activityList){
        activityList.innerHTML = '<div class="card-meta">No logs.</div>';
      }

      const statLogs = document.getElementById("statLogs");
      if(statLogs) statLogs.textContent = "0";

      alert("Activity cleared successfully.");
    }catch(err){
      alert("Clear activity error: " + (err.message || err));
    }
  }

  function installClearActivityButton(){
    let btn = document.getElementById("clearActivityBtn");

    // If header injection failed, add button near activity list
    if(!btn){
      const activityList = document.getElementById("activityList");
      if(activityList && activityList.parentElement){
        btn = document.createElement("button");
        btn.id = "clearActivityBtn";
        btn.className = "clear-activity-btn";
        btn.textContent = "Clear Activity";
        activityList.parentElement.insertBefore(btn, activityList);
      }
    }

    if(btn && !btn.dataset.boundClear){
      btn.dataset.boundClear = "1";
      btn.addEventListener("click", clearActivityLogs);
    }
  }

  document.addEventListener("DOMContentLoaded", installClearActivityButton);
  document.addEventListener("click", function(){ setTimeout(installClearActivityButton, 50); }, true);
  setInterval(installClearActivityButton, 1000);
})();
</script>

