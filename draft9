<style>
@font-face{font-family:'Krasar';src:url('/prayinfo/fonts/Krasar-Regular.woff') format('woff'),url('./fonts/Krasar-Regular.woff') format('woff'),url('fonts/Krasar-Regular.woff') format('woff');font-weight:normal;font-style:normal;font-display:swap;}*{font-family:'Krasar',sans-serif!important;}body{line-height:1.6;}

