button,input,select,textarea{font:inherit}.hidden{display:none!important}.glass{background:var(--glass);border:1px solid var(--stroke);box-shadow:0 18px 46px rgba(0,0,0,.28);backdrop-filter:blur(16px)}
.btn{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.08);color:#fff;border-radius:14px;padding:11px 15px;cursor:pointer}.btn:hover{background:rgba(255,255,255,.14)}.btn.primary{background:linear-gradient(135deg,var(--blue),var(--blue2))}.btn.danger{background:rgba(255,80,80,.16);color:#ffd0d0}.btn.small{padding:7px 10px;border-radius:10px;font-size:13px}.status{font-size:13px;color:var(--muted);min-height:20px;margin-top:10px}
.login-wrap{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:22px}.login-card{width:min(440px,100%);border-radius:26px;padding:26px}.brand{display:flex;align-items:center;gap:12px;font-size:24px;font-weight:700;margin-bottom:16px}.brand i{width:52px;height:52px;border-radius:18px;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,rgba(93,167,255,.36),rgba(255,255,255,.08));font-size:24px}.field{margin-bottom:13px}.field label{display:block;font-size:13px;color:#dce8f8;font-weight:600;margin-bottom:7px}.input-dark{width:100%;border:1px solid rgba(255,255,255,.14);border-radius:16px;background:rgba(255,255,255,.07);color:#fff;padding:13px 14px;outline:none}
.app{max-width:1500px;margin:0 auto;padding:16px}.nav{position:sticky;top:0;z-index:10;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;border-radius:22px;margin-bottom:16px}.nav-left{font-weight:700;font-size:18px}.nav-center{display:flex;gap:8px;flex-wrap:wrap}.nav-tab{border:0;background:transparent;color:#dbe5f2;padding:8px 12px;border-radius:12px;cursor:pointer}.nav-tab.active{background:linear-gradient(135deg,var(--blue),var(--blue2));color:#fff}.nav-right{display:flex;gap:8px;align-items:center;color:var(--muted);font-size:13px}
.page{display:none}.page.active{display:block}.layout{display:grid;grid-template-columns:350px 1fr;gap:16px}.panel{border-radius:24px;overflow:hidden}.panel-head{padding:16px;border-bottom:1px solid rgba(255,255,255,.09)}.panel-head h3{margin:0;font-size:19px}.panel-body{padding:14px}.search{position:relative;margin-bottom:12px}.search i{position:absolute;top:50%;left:12px;transform:translateY(-50%);color:#cce2ff}.search input{padding-left:38px}.list{display:flex;flex-direction:column;gap:10px;max-height:calc(100vh - 260px);overflow:auto}.card-list{padding:12px 14px;border-radius:16px;background:rgba(255,255,255,.055);border:1px solid rgba(255,255,255,.1);cursor:pointer}.card-list:hover,.card-list.active{background:rgba(93,167,255,.17)}.card-title{font-weight:700}.card-meta{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.5}.workspace{padding:14px}.toolbar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:12px}.shell{border-radius:24px;padding:18px;background:linear-gradient(180deg,rgba(255,255,255,.1),rgba(255,255,255,.05));border:1px solid rgba(255,255,255,.12)}.empty{min-height:320px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);flex-direction:column;gap:10px}.empty i{font-size:52px;color:#cce2ff}
.paper{width:min(100%,900px);margin:0 auto;background:var(--paper);color:var(--ink);padding:24px 28px 32px;border-radius:2px;box-shadow:0 14px 40px rgba(0,0,0,.12)}.paper h1{text-align:center;margin:0 0 10px;font-size:27px}.subhead{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;align-items:end;margin-bottom:10px;font-size:18px}.subhead .center{text-align:center}.subhead .right{text-align:right}.inline{display:inline-flex;align-items:baseline;gap:8px;white-space:nowrap}.line-input{width:150px;border:0;border-bottom:1px solid transparent;background:transparent;outline:none;color:inherit}.date-input{width:175px}.field-picker{position:relative;display:inline-block}.field-toggle{border:0;background:transparent;font:inherit;font-weight:700;cursor:pointer;color:inherit;padding-right:28px}.field-panel{display:none;position:absolute;z-index:30;top:calc(100% + 8px);left:0;width:320px;max-height:310px;background:#fff;border:1px solid #cfd6de;border-radius:12px;box-shadow:0 18px 40px rgba(16,25,37,.16);overflow:hidden}.field-picker.open .field-panel{display:block}.field-search{width:calc(100% - 20px);margin:10px;padding:8px 10px;border:1px solid #cfd6de;border-radius:8px}.field-list{max-height:250px;overflow:auto}.field-option{display:block;width:100%;border:0;background:#fff;text-align:left;padding:8px 12px;cursor:pointer}.field-option:hover{background:#eef5ff}
table{width:100%;border-collapse:collapse;table-layout:fixed;border:1px solid var(--line)}td,th{border:1px solid var(--line);padding:0;vertical-align:middle}.label-cell{width:150px;padding:8px 10px;font-size:18px;font-weight:700;vertical-align:top}.participant-count{color:#2e5fbf}.field-cell textarea,.field-cell input{width:100%;border:0;background:transparent;outline:none;color:inherit;padding:10px 12px}.field-cell textarea{height:52px;min-height:52px;resize:none;overflow:hidden}.participant-wrap{display:flex;align-items:flex-start;gap:12px;padding:10px 12px;flex-wrap:wrap}.participant-wrap>span{font-size:18px;padding-top:5px}.selected-participant{display:flex;gap:8px;flex-wrap:wrap;min-height:32px;align-items:center;color:#183042}.pill{display:inline-flex;padding:5px 12px;border:1px solid #cfd6de;border-radius:999px;background:#f8fafc}.select-row{display:flex;gap:8px;flex-wrap:wrap}.select-row select{width:130px;border:1px solid #cfd6de;border-radius:8px;padding:6px 8px}.add-btn{border:1px solid #cfd6de;background:#fff;color:#183042;border-radius:8px;padding:6px 10px;cursor:pointer}.inner-table{border:0}.number-col{width:66px;text-align:center;font-size:18px}.name-col{width:250px}.name-display{padding:10px 12px}.prayer-header th{height:44px;font-size:18px;background:rgba(0,0,0,.02)}.prayer-row td{height:48px}.single-line{height:52px}
.manager-card{width:min(100%,980px);margin:0 auto;background:#fff;color:#111;border-radius:22px;padding:22px}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}.light-label{font-weight:700;margin-bottom:7px;display:block}.input-light{width:100%;border:1px solid #d6dde8;border-radius:13px;padding:11px 12px}.section{margin-top:16px;padding-top:14px;border-top:1px solid #e8edf3}.member-row{display:flex;gap:8px;margin-bottom:9px}.member-row input{flex:1}.json-box{background:#0f1724;color:#cfe1ff;border-radius:14px;padding:12px;overflow:auto;font:12px ui-monospace,monospace;max-height:240px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-bottom:16px}.stat{padding:18px;border-radius:22px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1)}.stat small{color:var(--muted)}.stat b{display:block;font-size:32px}.dash-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:16px}
@media(max-width:1100px){.layout,.dash-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.list{max-height:320px}}@media(max-width:760px){
.app{padding:10px}
.nav{flex-direction:column;align-items:flex-start}
.nav-right{width:100%;justify-content:space-between}
.layout,.grid2{grid-template-columns:1fr}
.stats{grid-template-columns:1fr}
.shell{overflow:hidden;padding:10px}

/* Mobile paper scaling */
.paper{
  width:900px;
  max-width:900px;
  transform:scale(calc((100vw - 52px) / 900));
  transform-origin:top left;
  margin:0;
  padding:24px 28px 32px;
  border-radius:2px;
}
#formBox{
  overflow:hidden;
}
#formBox .paper{
  margin-bottom:calc((100vw - 52px) / 900 * -1px);
}
.shell:has(.paper){
  min-height:calc(980px * ((100vw - 52px) / 900) + 20px);
}

/* fallback if :has is not supported */
.form-mobile-holder{
  width:100%;
  overflow:hidden;
}

.subhead{grid-template-columns:1fr 1fr 1fr;gap:16px;font-size:18px}
.subhead .center{text-align:center}
.subhead .right{text-align:right}
.name-col{width:250px}
.field-panel{width:320px}
.label-cell,.number-col,.participant-wrap>span{font-size:18px}
}

@media(max-width:420px){
.shell:has(.paper){
  min-height:calc(1040px * ((100vw - 42px) / 900) + 20px);
}
